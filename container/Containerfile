# SPDX-License-Identifier: MPL-2.0
# squeakwell Container Image
#
# Multi-stage build on Chainguard Wolfi base images. Stage 1 compiles the
# squeakwell Rust CLI; stage 2 is a minimal runtime image that carries only
# the binary. squeakwell is a batch recovery tool, not a service: it opens
# no listening port, so there is no EXPOSE and no HTTP health check. The
# VeriSimDB instance it writes to is named at run time by VERISIMDB_URL.
#
# Build with Podman:
#   podman build -t squeakwell:latest -f container/Containerfile .
#
# Run one recovery batch (working directory on a named volume):
#   podman run --rm -v squeakwell-data-<batch>:/data -e VERISIMDB_URL \
#     squeakwell:latest recover --workdir /data

# ============================================================================
# Stage 1: Builder
# ============================================================================
FROM cgr.dev/chainguard/wolfi-base:latest AS builder

RUN apk add --no-cache build-base pkgconf rust

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
COPY benches/ ./benches/
RUN cargo build --release --locked --bin squeakwell
# Output: /build/target/release/squeakwell

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM cgr.dev/chainguard/wolfi-base:latest

# OCI image labels (compatible with cerro-torre .ctp bundle metadata)
LABEL org.opencontainers.image.title="squeakwell" \
      org.opencontainers.image.description="Database recovery through cross-modal constraint propagation on VeriSimDB" \
      org.opencontainers.image.url="https://github.com/hyperpolymath/squeakwell" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/squeakwell" \
      org.opencontainers.image.vendor="hyperpolymath" \
      org.opencontainers.image.licenses="MPL-2.0" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>" \
      dev.cerrotorre.manifest="container/manifest.toml"

# ca-certificates: TLS roots for the https:// VERISIMDB_URL in production.
# Create the non-root user in the same layer.
RUN apk add --no-cache ca-certificates \
    && addgroup -S appuser && adduser -S appuser -G appuser

WORKDIR /app

COPY --from=builder /build/target/release/squeakwell /app/squeakwell

COPY container/entrypoint.sh /app/entrypoint.sh
COPY container/manifest.toml /app/manifest.toml

# Recovery working directories live under /data (mountable volume).
RUN chmod +x /app/entrypoint.sh \
    && mkdir -p /data && chown appuser:appuser /data \
    && chown -R appuser:appuser /app

ENV APP_LOG_FORMAT=json
ENV APP_DATA_DIR=/data

VOLUME ["/data"]

USER appuser

# Batch job: no EXPOSE, no HEALTHCHECK. Success is the exit code of one run.
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["--help"]
